{
  "name": "sketchpad",
  "productName": "Sketchpad",
  "version": "0.1.0",
  "description": "Menu bar sketchpad for giving LLMs a drawing",
  "homepage": "https://toddmoy.com/apps/sketchpad",
  "author": "Todd Moy",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc",
    "app": "electron-vite build && electron-builder --mac dir --universal",
    "dist": "electron-vite build && electron-builder --mac --universal --publish never",
    "release": "electron-vite build && electron-builder --mac --universal --publish always"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tldraw": "^5.5.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.toddmoy.sketchpad",
    "productName": "Sketchpad",
    "files": [
      "out/**"
    ],
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "publish": {
      "provider": "github",
      "owner": "toddmoy",
      "repo": "sketchpad",
      "releaseType": "release"
    },
    "dmg": {
      "artifactName": "Sketchpad.dmg"
    }
  },
  "packageManager": "pnpm@11.24.0"
}
